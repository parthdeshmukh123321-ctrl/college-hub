# PostgreSQL connection string (required). Example for local dev:
# DATABASE_URL=postgres://app:app@localhost:5432/app_db
# On Vercel: set this in Project Settings → Environment Variables (use a
# hosted Postgres such as Neon; Vercel has no built-in database).
DATABASE_URL=

# Admin key for moderation endpoints (required in production).
# If unset, local dev falls back to "admin123"; production FAILS CLOSED
# (all admin endpoints return 403) when this is empty.
ADMIN_KEY=

# Public base URL of the deployed site (used for metadata/canonical links).
# Example: NEXT_PUBLIC_BASE_URL=https://your-project.vercel.app
NEXT_PUBLIC_BASE_URL=
